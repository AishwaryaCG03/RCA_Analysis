# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rca_ai
# For local smoke tests only, a SQLite URL can be used instead:
# DATABASE_URL=sqlite:///./rca_ai.db
GROQ_API_KEY=
# A currently supported Groq production model; override if your Groq organization permits another model.
GROQ_MODEL=openai/gpt-oss-120b
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=10

# Frontend (frontend/.env)
# VITE_API_URL=http://localhost:8000/api/v1
